# Development .env (safe defaults for local/dev)
# Do NOT commit secrets in production. Replace with real secrets when deploying.
DB_HOST=localhost
DB_PORT=5432
USE_POSTGRES=false
DB_NAME=municipay_db
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=dev_secret
FLW_PUBLIC_KEY=dev_public_key
FLW_SECRET_KEY=dev_secret_key
# Other env vars used by services can be added here
